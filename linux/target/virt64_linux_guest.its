/*
 * Copyright (C) 2020-2026 Daniel Rossier <daniel.rossier@heig-vd.ch>
 *
 * Linux agency guest ITB for virt64 (armv8). Carries the Linux agency
 * kernel (Image) + its device tree + initrd. Paired with virt64_avz.itb
 * and loaded by U-Boot's e1c-boot command, which passes this ITB to AVZ
 * in x1; AVZ's loadAgency() loads the agency guest from it. The Linux
 * agency hosts the SO3 capsules (injected at runtime via EMISO).
 *
 * This program is free software; you can redistribute it and/or modify
 * it under the terms of the GNU General Public License version 2 as
 * published by the Free Software Foundation.
 *
 */

/dts-v1/;

/ {
	description = "Linux agency guest bundle for virt64 (armv8)";

	images {

		linux {
			description = "Linux agency kernel (guest)";
			data = /incbin/("../linux/arch/arm64/boot/Image");
			type = "guest";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x41000000>;
			entry = <0x41000000>;
		};

		fdt {
			description = "Linux agency device tree (AVZ-exposed)";
			data = /incbin/("../linux/arch/arm64/boot/dts/arm/virt64_guest.dtb");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			load = <0x50000000>;
		};

		initrd {
			description = "Linux agency initrd";
			data = /incbin/("../rootfs/board/virt64/initrd.cpio");
			type = "ramdisk";
			arch = "arm64";
			os = "linux";
			compression = "none";
			load = <0x50c00000>;
		};
	};

	configurations {
		/* Node name MUST be "capsule": U-Boot's e1c-boot command looks
		 * up the guest config by that fixed name (cmd/e1c_boot.c:
		 * e1c_load_fit(e1c_itb, "capsule", ...)). Same slot as the SO3
		 * guest; here it carries the Linux agency. */
		default = "capsule";

		capsule {
			description = "SOO Linux agency on virt64";
			loadables = "linux";
			fdt = "fdt";
			ramdisk = "initrd";
		};
	};
};
